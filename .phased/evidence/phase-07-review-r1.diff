diff --git a/explorer/index.html b/explorer/index.html
new file mode 100644
index 0000000..681d8fa
--- /dev/null
+++ b/explorer/index.html
@@ -0,0 +1,47 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>Knowledge graph explorer</title>
+    <style>
+      html, body { margin: 0; height: 100%; background: #0b0e14; color: #e6e6e6;
+        font: 13px/1.4 system-ui, sans-serif; overflow: hidden; }
+      #graph { position: absolute; inset: 0; }
+      .panel { position: absolute; background: rgba(20, 24, 34, 0.92); border: 1px solid #2a3142;
+        border-radius: 6px; padding: 10px; box-sizing: border-box; }
+      #controls { top: 12px; left: 12px; width: 260px; }
+      #controls input[type="search"] { width: 100%; box-sizing: border-box; padding: 4px 6px;
+        background: #0b0e14; color: inherit; border: 1px solid #2a3142; border-radius: 4px; }
+      #results { list-style: none; margin: 6px 0 0; padding: 0; max-height: 220px; overflow: auto; }
+      #results li { padding: 3px 4px; cursor: pointer; border-radius: 3px; }
+      #results li:hover { background: #222a3c; }
+      #filters { margin-top: 8px; }
+      #filters label { display: block; }
+      .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 4px; }
+      #details { top: 12px; right: 12px; width: 300px; max-height: calc(100% - 24px); overflow: auto; }
+      #details h2 { margin: 0 0 4px; font-size: 15px; }
+      #details h3 { margin: 10px 0 2px; font-size: 12px; text-transform: uppercase; color: #8a93a6; }
+      #details pre { white-space: pre-wrap; word-break: break-word; margin: 4px 0; }
+      #details ul { margin: 0; padding-left: 16px; }
+      #details a { color: #7fb2ff; cursor: pointer; }
+      #error { bottom: 12px; left: 12px; max-width: 420px; border-color: #7a2b2b; }
+      #error p { margin: 0 0 8px; color: #ff9b9b; }
+      [hidden] { display: none !important; }
+    </style>
+  </head>
+  <body>
+    <div id="graph"></div>
+    <div id="controls" class="panel">
+      <input id="search" type="search" placeholder="Search nodes" autocomplete="off" />
+      <ul id="results"></ul>
+      <div id="filters"></div>
+    </div>
+    <div id="details" class="panel" hidden></div>
+    <div id="error" class="panel" hidden>
+      <p id="error-text"></p>
+      <label>Load a graph.json: <input id="file" type="file" accept=".json,application/json" /></label>
+    </div>
+    <script type="module" src="/src/main.ts"></script>
+  </body>
+</html>
