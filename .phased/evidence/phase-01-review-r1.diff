+}
+
+#[test]
+fn test_AC_01_01_project_none_when_no_cwd() {
+    let s = parse(vec![json!({
+        "type": "user",
+        "sessionId": "s1",
+        "message": {"role": "user", "content": "hello"}
+    })]);
+    assert_eq!(s.cwd, None);
