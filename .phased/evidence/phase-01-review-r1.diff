+#[test]
+fn test_AC_01_01_files_touched_ignores_tool_results_and_text() {
+    let s = bare_session(vec![
+        Message {
+            role: Role::User,
+            timestamp: None,
+            blocks: vec![
+                text("/home/user/mentioned.rs"),
+                Block::ToolResult {
+                    tool_use_id: "t".to_string(),
+                    content: "/home/user/result.rs".to_string(),
+                    is_error: false,
+                },
+            ],
+        },
