+}
+
+fn assistant_line(sid: &str, ts: &str, msg_id: &str, text: &str) -> String {
+    json!({
+        "type": "assistant", "sessionId": sid, "timestamp": ts,
+        "message": {"id": msg_id, "model": "claude-opus-5-5", "role": "assistant",
+                    "content": [{"type": "text", "text": text}]}
+    })
+    .to_string()
