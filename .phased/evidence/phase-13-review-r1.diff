+    const an = analyzeGraph(g);
+    const ids = bridgeIds(an);
+    expect([...ids].sort()).toEqual(an.bridges.map((b) => b.id).sort());
+    expect([...ids].sort()).toEqual(['p:shared', 'tx']);
+    expect(ids.has('ta1')).toBe(false);
+    expect(ids.has('p:solo')).toBe(false);
+  });
