+describe('monthRange', () => {
+  it('AC-12-06 returns the timeline months in order', () => {
+    const a = analysis({
+      timeline: [
+        { month: '2024-11', sessions: 2, topTopics: [] },
+        { month: '2025-01', sessions: 1, topTopics: ['x'] },
+        { month: '2025-04', sessions: 5, topTopics: [] },
