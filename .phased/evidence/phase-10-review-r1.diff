+
+  const numberingNodes = ['c2', 'm3', 'b1', 'a0', 'c1', 'm1', 'b3', 'm4', 'c3', 'b2', 'm2'];
+  const numberingEdges = (): WeightedEdge[] => [
+    ...clique(['m1', 'm2', 'm3', 'm4']),
+    ...clique(['c1', 'c2', 'c3']),
