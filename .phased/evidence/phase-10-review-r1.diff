+    expect(big?.lastAt).toBe('2026-01-04T00:00:00Z');
+  });
+});
+
+// ---------- timeline ----------
+
+describe('analyzeGraph timeline', () => {
+  it('AC-10-09 groups dated sessions by month ascending with counts and top 3 topics', () => {
+    const g = build(
